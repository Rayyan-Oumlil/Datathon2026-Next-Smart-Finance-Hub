# Copy to .env and fill in. Check it with: node scripts/check-env.mjs
# Every variable is read at runtime except NEXT_PUBLIC_*, which Next.js fixes when the app is built.
# Never commit .env.

# --- Required ---------------------------------------------------------------
# Finnhub key (free at finnhub.io). Several keys, comma-separated, are rotated: each adds 60 requests/min
FINNHUB_API_KEY=
# FINNHUB_API_KEYS=key_one,key_two

# --- Market data ------------------------------------------------------------
# "cached" (default): quotes refresh hourly. "realtime": every 15 s.
# Fixed at build time: rebuild after changing it (docker compose passes it to the build).
# NEXT_PUBLIC_OPENSTOCK_DATA_MODE=cached

# Sentiment card on stock pages. Display only: never used in a filter, a score or the agent.
# ADANOS_API_KEY=
# ADANOS_API_BASE_URL=https://api.adanos.org

# --- Deployment -------------------------------------------------------------
# Public URL of the app, used in the sitemap and robots.txt
# APP_URL=http://localhost:3000

# Each browser gets an anonymous session cookie signed with SESSION_SECRET (32+ characters; required in production)
# SESSION_SECRET=
# Local use only: the user of a browser without a session cookie (no cookie is written for it). A session cookie set
# by a hidden profile address (/u/new, /u/amira, /u/mateo, /u/robert) still wins. Leave unset in production.
# DEMO_USER_ID=demo-user

# --- Agent service and stores (see docs/agent-api.md) --------------------------
# AGENT_URL=http://localhost:8080
# AGENT_RUNTIME_ARN=
# INTERNAL_API_TOKEN=
# AWS_REGION=us-east-1
# DYNAMODB_ENDPOINT=http://localhost:8000
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=

# --- Voice (Amazon Transcribe dictation, Amazon Polly spoken replies) --------
# Read at every request, so it changes per deployment without a rebuild. "true" offers voice; any other value turns
# it off: /api/voice/token and /api/voice/speak answer 404 and the panel shows no microphone or speaker.
# Unset: on in development (NODE_ENV is not production), off in production. The browser allows the microphone only
# over HTTPS or on localhost, so leave it off on a plain-HTTP deployment. Transcribe is billed per streamed minute.
# VOICE_ENABLED=false
