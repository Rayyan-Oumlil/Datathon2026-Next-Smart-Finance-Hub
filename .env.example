# Copy to .env and fill in. Check it with: node scripts/check-env.mjs
# Every variable is read at runtime except NEXT_PUBLIC_*, which Next.js fixes when the app is built.
# Never commit .env.

# --- Required ---------------------------------------------------------------
# Finnhub key (free at finnhub.io). Several keys, comma-separated, are rotated: each adds 60 requests/min
FINNHUB_API_KEY=
# FINNHUB_API_KEYS=key_one,key_two

# --- Market data ------------------------------------------------------------
# "cached" (default): quotes refresh hourly. "realtime": every 15 s.
# Fixed at build time: rebuild after changing it (docker compose passes it to the build).
# NEXT_PUBLIC_OPENSTOCK_DATA_MODE=cached

# Sentiment card on stock pages. Display only: never used in a filter, a score or the agent.
# ADANOS_API_KEY=
# ADANOS_API_BASE_URL=https://api.adanos.org

# --- Deployment -------------------------------------------------------------
# Public URL of the app, used in the sitemap and robots.txt
# APP_URL=http://localhost:3000
